{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/demo/jam-birthday",
      "destination": "/stationery-jam-demo.html"
    },
    {
      "source": "/studio/demo/jam-birthday",
      "destination": "/stationery.html"
    },
    {
      "source": "/demo/birthday",
      "destination": "/card-page.html"
    },
    {
      "source": "/studio",
      "destination": "/index.html"
    },
    {
      "source": "/studio/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [],
  "functions": {
    "api/card.js": {
      "includeFiles": "public/card.json"
    },
    "api/stationery.js": {
      "includeFiles": "public/stationery-cards.json"
    }
  }
}
